            label = "OE_UMLAUT";
        };

        // Plain adaptive-key for T (no mod), used only as the first step inside digraph macros

        ak_t: ak_t {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&kp T>;

            akt_t_comma {
                trigger-keys = <COMMA>;
                bindings = <&kp BSPC &kp LS(T)>;
                max-prior-idle-ms = <500>;
                strict-modifiers;
            };
        };

        ak_c: ak_c {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&kp C>;

            akt_c_comma {
                trigger-keys = <COMMA>;
                bindings = <&kp BSPC &kp LS(C)>;
                max-prior-idle-ms = <500>;
                strict-modifiers;
            };
        };

        ak_s: ak_s {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&kp S>;

            akt_s_comma {
                trigger-keys = <COMMA>;
                bindings = <&kp BSPC &kp LS(S)>;
                max-prior-idle-ms = <500>;
                strict-modifiers;
            };
        };

        ak_i: ak_i {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&kp I>;

            akt_i_comma {
                trigger-keys = <COMMA>;
                bindings = <&kp BSPC &kp LS(I)>;
                max-prior-idle-ms = <500>;
