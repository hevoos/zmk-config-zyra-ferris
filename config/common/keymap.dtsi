            timeout-ms = <20>;
        };

        ion {
            bindings = <&ion>;
            key-positions = <POS06 POS07 POS08>;
            timeout-ms = <20>;
        };

        ing {
            bindings = <&ing>;
            key-positions = <POS26 POS27 POS28>;
            timeout-ms = <20>;
