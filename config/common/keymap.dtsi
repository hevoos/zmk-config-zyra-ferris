        redo {
            bindings = <&kp LC(LS(Z))>;
            key-positions = <POS20 POS21 POS22 POS23>;
            timeout-ms = <20>;
            require-prior-idle-ms = <150>;
        };

        quit {
            bindings = <&kp LC(Q)>;
            key-positions = <POS04 POS14>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
        };

        new {
            bindings = <&kp LC(N)>;
            key-positions = <POS14 POS24>;
            timeout-ms = <20>;
            require-prior-idle-ms = <150>;
        };

        close {
            bindings = <&kp LC(W)>;
            key-positions = <POS05 POS15>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
        };

