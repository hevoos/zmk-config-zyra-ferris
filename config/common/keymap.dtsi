        };

        ch {
            bindings = <&ch>;
            key-positions = <POS11 POS12>;
            timeout-ms = <20>;
        };

        ph {
            bindings = <&ph>;
            key-positions = <POS21 POS23>;
            timeout-ms = <20>;
        };

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <POS21 POS22>;
            timeout-ms = <20>;
            require-prior-idle-ms = <150>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <POS22 POS23>;
            timeout-ms = <20>;
            require-prior-idle-ms = <150>;
        };

