                trigger-keys = <COMMA>;
                bindings = <&kp BSPC &kp LS(P)>;
                max-prior-idle-ms = <500>;
                strict-modifiers;
            };
        };

        th: th {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <10>;
            bindings =
                <&ak_t>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_release>,
                <&kp RSHFT>,
                <&macro_tap>,
                <&kp H>;

            label = "TH";
        };

        ch: ch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <10>;
            bindings =
                <&ak_c>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_release>,
                <&kp RSHFT>,
                <&macro_tap>,
                <&kp H>;

            label = "CH";
        };

        sch: sch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <10>;
            bindings =
                <&ak_s>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_release>,
                <&kp RSHFT>,
                <&macro_tap>,
                <&kp C &kp H>;

            label = "SCH";
        };

        tch: tch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <10>;
            bindings =
                <&ak_t>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_release>,
                <&kp RSHFT>,
                <&macro_tap>,
                <&kp C &kp H>;

            label = "TCH";
        };

        qu: qu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <10>;
            bindings =
                <&kp Q>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_release>,
                <&kp RSHFT>,
                <&macro_tap>,
                <&kp U>;

            label = "QU";
        };

        wh: wh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <10>;
            bindings =
                <&ak_w>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_release>,
                <&kp RSHFT>,
                <&macro_tap>,
                <&kp H>;

            label = "WH";
        };

        sh: sh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <10>;
            bindings =
                <&ak_s>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_release>,
                <&kp RSHFT>,
                <&macro_tap>,
                <&kp H>;

            label = "SH";
        };

        ing: ing {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <10>;
            bindings =
                <&kp I>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_release>,
                <&kp RSHFT>,
                <&macro_tap>,
                <&kp N &kp G>;

            label = "ING";
        };

        ion: ion {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <10>;
            bindings = <&kp I &kp O &kp N>;
            label = "ION";
        };

        gh: gh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <10>;
            bindings =
                <&ak_g2>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_release>,
                <&kp RSHFT>,
                <&macro_tap>,
                <&kp H>;

            label = "GH";
        };

        ph: ph {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <10>;
            bindings =
                <&ak_p2>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_release>,
                <&kp RSHFT>,
                <&macro_tap>,
                <&kp H>;

            label = "PH";
        };

        findsel: findsel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LC(C)>,
                <&macro_tap>,
                <&kp LC(F)>,
                <&macro_tap>,
                <&kp LC(V)>,
                <&macro_tap>,
                <&kp RETURN>,
                <&macro_tap>,
                <&kp LC(G)>;

            label = "FINDSEL";
        };

        selword: selword {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LC(LEFT)>,
                <&macro_tap>,
                <&kp LS(LC(RIGHT))>;

            label = "SELWORD";
        };

        your: your {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp Y>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_release>,
                <&kp RSHFT>,
                <&macro_tap>,
                <&kp O &kp U &kp R>;

            label = "YOUR";
        };

        Ill: Ill {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(I) &kp SQT &kp L &kp L &kp SPACE>;
            label = "ILL";
        };

        Id: Id {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(I) &kp SQT &kp D &kp SPACE>;
            label = "ID";
        };

        Im: Im {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(I) &kp SQT &kp M &kp SPACE>;
            label = "IM";
        };

        Ive: Ive {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(I) &kp SQT &kp V &kp E &kp SPACE>;
            label = "IVE";
        };

        youve: youve {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp Y>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_release>,
                <&kp RSHFT>,
                <&macro_tap>,
                <&kp O &kp U &kp APOSTROPHE &kp V &kp E &kp SPACE>;

            label = "YOUVE";
        };

        youre: youre {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp Y>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_release>,
                <&kp RSHFT>,
                <&macro_tap>,
                <&kp O &kp U &kp APOSTROPHE &kp R &kp E &kp SPACE>;

            label = "YOURE";
        };

        youd: youd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp Y>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_release>,
                <&kp RSHFT>,
                <&macro_tap>,
                <&kp O &kp U &kp APOSTROPHE &kp D &kp SPACE>;

            label = "YOUD";
        };

        youll: youll {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp Y>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_release>,
                <&kp RSHFT>,
                <&macro_tap>,
                <&kp O &kp U &kp APOSTROPHE &kp L &kp L &kp SPACE>;

            label = "YOULL";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
  LAYOUT(
    &ak_x,           &ak_g,           &ak_m,           &ak_p,           &ak_j,           &kp APOS,        &ak_ae,          &kp DOT,         &kp COMMA,       &kp MINUS,
    &ak_hml_s,       &kp C,       &ak_hml_n,       &ak_hml_t,       &ak_k,           &ak_aa,          &ak_hmr_a,       &ak_hmr_e,       &ak_hmr_i,       &ak_hmr_h,
    &ak_w,           &ak_f,           &ak_l,           &ak_d,           &ak_v,           &ak_oe,          &ak_u,           &ak_o,           &ak_y,           &ak_b,
    &lt 1 BACKSPACE, &lt_r 2 R,       &lt 3 SPACE,     &lt 4 ENTER
  )
    >;
        };

        layer_1 {
            bindings = <
  LAYOUT(
    &kp LA(NUMBER_6),    &kp LA(NUMBER_7),    &kp LA(N8),          &kp LA(N9),          &kp LA(N0),          &kp HOME,            &kp PAGE_UP,         &kp UP_ARROW,        &kp PAGE_DOWN,       &kp END,
    &kp LA(NUMBER_1),    &kp LA(NUMBER_2),    &kp LA(NUMBER_3),    &kp LA(NUMBER_4),    &kp LA(NUMBER_5),    &kp LC(LEFT_ARROW),  &kp LEFT_ARROW,      &kp DOWN_ARROW,      &kp RIGHT,           &kp LC(RIGHT_ARROW),
    &kp LEFT_CONTROL,    &kp LEFT_SHIFT,      &kp LEFT_ALT,        &kp TAB,             &kp Q,               &kp LEFT_ALT,        &msc SCRL_UP,        &msc SCRL_DOWN,      &trans,              &kp LEFT_GUI,
    &trans,              &trans,              &kp LC(LS(TAB)),     &kp LC(TAB)
  )
    >;
        };

        layer_2 {
            bindings = <
  LAYOUT(
    &kp F11,         &kp F12,         &trans,          &trans,          &kp PRINTSCREEN, &kp SLASH,       &kp N7,          &kp N8,          &kp N9,          &kp PLUS,
    &kp F6,          &kp F7,          &kp F8,          &kp F9,          &kp F10,         &kp ASTRK,       &kp NUMBER_4,    &kp N5,          &kp NUMBER_6,    &kp EQUAL,
    &kp F1,          &kp F2,          &kp F3,          &kp F4,          &kp F5,          &kp COMMA,       &kp NUMBER_1,    &kp NUMBER_2,    &kp NUMBER_3,    &kp MINUS,
    &trans,          &trans,          &kp N0,          &trans
  )
    >;
        };

        layer_3 {
            bindings = <
  LAYOUT(
    &bt BT_CLR_ALL,    &bt BT_CLR,        &trans,            &trans,            &trans,            &kp LESS_THAN,     &kp ASTRK,         &kp HASH,          &kp PERCENT,       &kp GREATER_THAN,
    &trans,            &trans,            &trans,            &trans,            &trans,            &kp LEFT_BRACE,    &kp LEFT_BRACKET,  &kp PIPE,          &kp RIGHT_BRACKET, &kp RIGHT_BRACE,
    &bt BT_SEL 0,      &bt BT_SEL 1,      &bt BT_SEL 2,      &bt BT_SEL 3,      &bt BT_SEL 4,      &kp DOLLAR,        &kp DOT,           &kp SLASH,         &kp AMPS,          &kp CARET,
    &trans,            &trans,            &trans,            &trans
  )
    >;
        };

        layer_4 {
            bindings = <
  LAYOUT(
    &trans,          &trans,          &mkp MB3,        &trans,          &trans,          &trans,          &msc SCRL_UP,    &mmv MOVE_UP,    &msc SCRL_DOWN,  &trans,
    &trans,          &mkp MB4,        &mkp RCLK,       &mkp LCLK,       &mkp MB5,        &msc SCRL_LEFT,  &mmv MOVE_LEFT,  &mmv MOVE_DOWN,  &mmv MOVE_RIGHT, &msc SCRL_RIGHT,
    &trans,          &trans,          &trans,          &trans,          &trans,          &trans,          &msc SCRL_UP,    &msc SCRL_DOWN,  &trans,          &trans,
    &trans,          &trans,          &trans,          &trans
  )
    >;
        };

        layer_5 {
            bindings = <
  LAYOUT(
    &bt BT_PRV,           &trans,               &trans,               &bt BT_CLR,           &bt BT_CLR_ALL,       &kp C_BRIGHTNESS_DEC, &kp C_BRI_INC,        &kp C_VOLUME_DOWN,    &kp C_VOLUME_UP,      &kp K_MUTE,
    &bt BT_PRV,           &bt BT_NXT,           &trans,               &trans,               &trans,               &kp C_PREVIOUS,       &kp C_PLAY_PAUSE,     &kp C_NEXT,           &trans,               &trans,
    &bt BT_SEL 0,         &bt BT_SEL 1,         &bt BT_SEL 2,         &bt BT_SEL 3,         &bt BT_SEL 4,         &trans,               &trans,               &trans,               &trans,               &trans,
    &trans,               &trans,               &trans,               &trans
  )
    >;
        };

        layer_6 {
            bindings = <
  LAYOUT(
    &trans, &trans, &trans, &trans, &trans, &trans, &trans, &trans, &trans, &trans,
    &trans, &trans, &trans, &trans, &trans, &trans, &trans, &trans, &trans, &trans,
    &trans, &trans, &trans, &trans, &trans, &trans, &trans, &trans, &trans, &trans,
    &trans, &trans, &trans, &trans
  )
    >;
        };

        layer_7 {
            bindings = <
  LAYOUT(
    &studio_unlock, &studio_unlock, &trans,         &trans,         &bt BT_CLR_ALL, &trans,         &trans,         &trans,         &trans,         &studio_unlock,
    &sys_reset,     &trans,         &trans,         &trans,         &trans,         &trans,         &trans,         &trans,         &trans,         &sys_reset,
    &bootloader,    &trans,         &trans,         &trans,         &trans,         &trans,         &trans,         &trans,         &trans,         &bootloader,
    &trans,         &trans,         &kp A,          &trans
  )
    >;
        };
    };

    // Layer 1 (RIGHT) + Layer 2 (LEFT) at the same time -> Layer 7 (TRI)

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <7>;
        };

        funf {
            if-layers = <2 4>;
            then-layer = <5>;
        };
    };
};
